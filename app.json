{
  "expo": {
    "name": "OfflineLocker",
    "slug": "offlinelocker",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/offlinelocker-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.offlinelocker.app",
      "infoPlist": {
        "NSCameraUsageDescription": "OfflineLocker requires camera access to capture and store photos securely.",
        "NSPhotoLibraryUsageDescription": "OfflineLocker requires photo library access to select and store photos securely."
      }
    },
    "android": {
      "versionCode": 15,
      "adaptiveIcon": {
        "backgroundColor": "#0284C7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.offlinelocker.app"
    },
    "web": {
      "favicon": "./assets/offlinelocker-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "OfflineLocker requires photo library access to select and store photos securely.",
          "cameraPermission": "OfflineLocker requires camera access to capture and store photos securely."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3e535200-7b4c-417c-ab44-6b7d3aaf50ee"
      }
    }
  }
}
