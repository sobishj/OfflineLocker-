{
  "expo": {
    "name": "OfflineLocker",
    "slug": "offlinelocker",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/offlinelocker-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#0284C7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.offlinelocker.app"
    },
    "web": {
      "favicon": "./assets/offlinelocker-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "3e535200-7b4c-417c-ab44-6b7d3aaf50ee"
      }
    }
  }
}
